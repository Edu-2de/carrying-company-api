generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DELIVERER
  MANAGER
}

model User {
  id        String    @id @default(uuid())
  name      String
  cpf       String    @unique
  email     String    @unique
  password  String
  phone     String
  role      UserRole
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  ordersToDeliver Order[]

  @@map("users")
}

model Recipient {
  id        String    @id @default(uuid())
  name      String
  cpf       String    @unique
  phone     String
  latitude  Float
  longitude Float
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  ordersToReceive Order[]
  notifications   Notification[]

  @@map("recipients")
}

enum OrderStatus {
  orderProcessed
  inTransit
  outForDelivery
  delivered
  returned
}

model Order {
  id           String      @id @default(uuid())
  title        String
  status       OrderStatus @default(orderProcessed)
  fileName     String?
  latitude     Float
  longitude    Float
  expectedDate DateTime    @map("expected_date")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime?   @updatedAt @map("updated_at")

  delivererId String? @map("deliverer_id") // Entregador é opcional no início
  recipientId String  @map("recipient_id") // Destinatário é obrigatório

  deliverer User?     @relation(fields: [delivererId], references: [id])
  recipient Recipient @relation(fields: [recipientId], references: [id])

  @@map("orders")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  recipientId String    @map("recipient_id")
  recipient   Recipient @relation(fields: [recipientId], references: [id])

  @@map("notifications")
}
